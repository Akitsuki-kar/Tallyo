{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tallyo 主窗口默认权限（跨桌面与移动）：核心运行 + 文件对话框（PDF 导出）+ 文件系统写入。系统密钥库权限见 desktop-keyring.json（仅桌面）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$PICTURE/**" }
      ]
    }
  ]
}
