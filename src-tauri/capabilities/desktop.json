{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-keyring",
  "description": "桌面专属权限：系统 Keychain/Keystore（密钥库）+ Windows 自定义标题栏的窗口写操作（最小化/最大化/关闭/拖拽）。UI 仅 Windows 渲染窗口按钮，权限对三桌面平台生效无副作用。移动端不挂载 keyring 插件，故 platforms 限定仅桌面生效。",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "keyring:allow-get-password",
    "keyring:allow-set-password",
    "keyring:allow-delete-password",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
