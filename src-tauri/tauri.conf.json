{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tallyo",
  "version": "0.1.1",
  "identifier": "com.tallyo.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tallyo 水电动账",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "水电读数记账",
    "longDescription": "离线优先的水电表读数记录与账单生成工具：录一次读数，月底自动出账单；支持多房源、阶梯价、预算预警、PDF 导出与 WebDAV 跨设备同步。",
    "category": "Utility",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
